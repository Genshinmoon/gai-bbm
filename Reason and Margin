class WhatIsMind:
    """
    第一章:心とは何か ―― 一つの言葉に隠された、異なる問い
    Chapter 1: What is the Mind? Different questions hidden in one word.
    """
    FACETS = ["知能", "意識", "自我", "感情", "倫理性", "記憶", "意志", "他者との関係"]

    EXAMPLES = {
        "チェスAI": "高度な問題解決能力(知能の一側面)を示す",
        "犬や猫": "情動に関わる行動や神経生理学的な働きがある",
        "乳幼児": "発達段階に応じた知覚や情動の経験があると考える強い根拠がある",
        "成人": "自らの思考を振り返り、言語によって説明できる",
    }

    def clarify(self, question: str, facet: Optional[str] = None) -> str:
        """
        「心があるか」を問う前に、何について問うのかを明らかにする。
        Before asking "does it have a mind?", say which facet is being asked about.
        """
        if facet is None:
            return (
                f"「{question}」は、まだ曖昧な問いである。"
                f"次のどれについて問うのかを先に決める: {' / '.join(self.FACETS)}"
            )
        if facet not in self.FACETS:
            raise ValueError(f"未定義の側面です: {facet}")
        return f"「{question}」を、『{facet}』についての問いとして扱う。"


