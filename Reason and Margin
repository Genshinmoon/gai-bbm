class EvidenceStrength(Enum):
    """
    証拠の強さを区別する。(終章:「証拠の強さを区別すること」)
    Distinguish the strength of evidence.
    """
    NONE = "確立した証拠はない"
    WEAK = "弱い"
    MODERATE = "中程度"
    STRONG = "強い"


class Dimension(Enum):
    """第二章:四つの次元 / The four dimensions."""
    COGNITIVE = "認知"
    PHENOMENAL = "現象"
    RELATIONAL = "関係"
    CIVILIZATIONAL = "文明"


@dataclass(frozen=True)
class Claim:
    """
    主張と、その証拠の強さ。可能性と事実を混同しないための最小単位。
    A claim with its evidence strength; keeps possibility and fact apart.
    """
    statement: str
    evidence: EvidenceStrength
    note: str = ""

    def treat_as(self) -> str:
        if self.evidence is EvidenceStrength.STRONG:
            return "事実として扱える(新しい証拠には開いておく)"
        if self.evidence is EvidenceStrength.MODERATE:
            return "有力な仮説として扱う"
        if self.evidence is EvidenceStrength.WEAK:
            return "仮説として扱う"
        return "未解明として扱う(事実とも不可能とも断定しない)"


