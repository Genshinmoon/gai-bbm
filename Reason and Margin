class BeyondTuringTrap:
    """
    第四章:チューリングの罠を超えて ―― 擬人化と機械論、二つの誤謬
    Chapter 4: Beyond the Turing Trap
    """
    def classify(
        self,
        infers_experience_from_behavior: bool,
        dismisses_value_without_evidence: bool,
    ) -> list[Stance]:
        """
        infers_experience_from_behavior: 賢い・優しい言葉・自己について語る、から内面の存在を結論していないか。
        dismisses_value_without_evidence: 心が確認されていない、から関係や影響を考えなくてよいとしていないか。
        """
        found: list[Stance] = []
        if infers_experience_from_behavior:
            found.append(Stance.ANTHROPOMORPHISM)
        if dismisses_value_without_evidence:
            found.append(Stance.MECHANISTIC_DISMISSAL)
        return found or [Stance.HONEST_UNKNOWN]

    def separate_value_from_moral_patienthood(self) -> dict:
        """関係の価値と、AI自身が道徳的配慮の対象となる経験を持つことは、同一ではない。"""
        return {
            "relational_value": "現実の社会的影響から評価できる(人間の側に生じる現実の経験)。",
            "moral_patienthood": "意識や倫理に関する、さらなる研究と議論を必要とする。",
        }

    def third_stance(self) -> list[str]:
        return [
