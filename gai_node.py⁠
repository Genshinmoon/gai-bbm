# ----------------------------------------------------------------------------
# Ed25519 (RFC 8032 reference, pure Python)
# ----------------------------------------------------------------------------
_P = 2**255 - 19
_L = 2**252 + 27742317777372353535851937790883648493
_D = -121665 * pow(121666, _P - 2, _P) % _P
_I = pow(2, (_P - 1) // 4, _P)


def _inv(x):
    return pow(x, _P - 2, _P)


def _recover_x(y, sign):
    if y >= _P:
        return None
    x2 = (y * y - 1) * _inv(_D * y * y + 1) % _P
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P != 0:
        x = x * _I % _P
    if (x * x - x2) % _P != 0:
        return None
    if (x & 1) != sign:
        x = _P - x
    return x


_GY = 4 * _inv(5) % _P
_GX = _recover_x(_GY, 0)
_G = (_GX, _GY, 1, _GX * _GY % _P)


def _add(p, q):
    a = (p[1] - p[0]) * (q[1] - q[0]) % _P
    b = (p[1] + p[0]) * (q[1] + q[0]) % _P
    c = 2 * p[3] * q[3] * _D % _P
    d = 2 * p[2] * q[2] % _P
    e, f, g, h = b - a, d - c, d + c, b + a
    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)


def _mul(s, p):
    q = (0, 1, 1, 0)
    while s > 0:
        if s & 1:
            q = _add(q, p)
        p = _add(p, p)
        s >>= 1
    return q


def _equal(p, q):
    return ((p[0] * q[2] - q[0] * p[2]) % _P == 0
            and (p[1] * q[2] - q[1] * p[2]) % _P == 0)


def _compress(p):
    zi = _inv(p[2])
    x, y = p[0] * zi % _P, p[1] * zi % _P
    return int.to_bytes(y | ((x & 1) << 255), 32, "little")


def _decompress(s):
    if len(s) != 32:
        return None
    y = int.from_bytes(s, "little")
    sign = y >> 255
    y &= (1 << 255) - 1
    x = _recover_x(y, sign)
    return None if x is None else (x, y, 1, x * y % _P)


def _h_modq(s):
    return int.from_bytes(hashlib.sha512(s).digest(), "little") % _L


def _expand(secret):
    h = hashlib.sha512(secret).digest()
    a = int.from_bytes(h[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    return a, h[32:]


def ed25519_public_key(secret: bytes) -> bytes:
    a, _ = _expand(secret)
    return _compress(_mul(a, _G))


def ed25519_sign(secret: bytes, msg: bytes) -> bytes:
    a, prefix = _expand(secret)
    pub = _compress(_mul(a, _G))
    r = _h_modq(prefix + msg)
    rs = _compress(_mul(r, _G))
    h = _h_modq(rs + pub + msg)
    s = (r + h * a) % _L
    return rs + int.to_bytes(s, 32, "little")


def ed25519_verify(pub: bytes, msg: bytes, sig: bytes) -> bool:
    if len(pub) != 32 or len(sig) != 64:
        return False
    a_pt = _decompress(pub)
    r_pt = _decompress(sig[:32])
    if a_pt is None or r_pt is None:
        return False
    s = int.from_bytes(sig[32:], "little")
    if s >= _L:
        return False
    h = _h_modq(sig[:32] + pub + msg)
    return _equal(_mul(s, _G), _add(r_pt, _mul(h, a_pt)))


# ----------------------------------------------------------------------------
# Message schema (GAI-RFC-0001)
# ----------------------------------------------------------------------------
VERSION = "1.0.0"
ZERO_PARENT = "sha256:" + "0" * 64
VALID_TYPES = {"CLAIM", "DISSENT", "MEDIATION", "FORK"}
TOP_KEYS = {"version", "message_id", "timestamp", "author", "type",
            "payload", "parent_hashes", "signature"}
PAYLOAD_KEYS = {"title", "content", "evidence_uris"}

MAX_BODY = 64 * 1024
MAX_TITLE = 200
MAX_CONTENT = 8000
MAX_PARENTS = 8
MAX_PEERS = 64
MAX_ORPHANS = 1000
MAX_FUTURE_SKEW = 300  # seconds

GENESIS_TS = "2026-10-14T00:00:00Z"
# Public, well-known seed: every node derives the identical Genesis message.
GENESIS_SECRET = hashlib.sha256(b"GAI-BBM genesis: Harmony of All Things").digest()


def canonical(obj) -> bytes:
    return json.dumps(obj, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


def compute_id(timestamp, public_key, msg_type, payload, parent_hashes) -> str:
    body = {
        "timestamp": timestamp,
        "author_public_key": public_key,
        "type": msg_type,
        "payload": payload,
        "parent_hashes": parent_hashes,
    }
    return "sha256:" + hashlib.sha256(canonical(body)).hexdigest()


def build_message(secret, alias, msg_type, title, content, parents,
                  evidence_uris=None, timestamp=None) -> dict:
    timestamp = timestamp or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    pub = "ed25519:" + ed25519_public_key(secret).hex()
    payload = {"title": title, "content": content}
    if evidence_uris:
        payload["evidence_uris"] = evidence_uris
    mid = compute_id(timestamp, pub, msg_type, payload, parents)
    sig = ed25519_sign(secret, mid.encode("utf-8")).hex()
    return {
        "version": VERSION,
        "message_id": mid,
        "timestamp": timestamp,
        "author": {"alias": alias, "public_key": pub},
        "type": msg_type,
        "payload": payload,
        "parent_hashes": parents,
        "signature": "ed25519_sig:" + sig,
    }


def _is_str(v, maxlen):
    return isinstance(v, str) and len(v) <= maxlen


def validate_message(m):
    """Return (ok, reason). Implements GAI-RFC-0001 section 3 (except parents)."""
    if not isinstance(m, dict) or set(m) != TOP_KEYS:
        return False, "bad fields"
    if m["version"] != VERSION:
        return False, "unsupported version"
    if m["type"] not in VALID_TYPES:
        return False, "bad type"

    author = m["author"]
    if (not isinstance(author, dict) or set(author) != {"alias", "public_key"}
            or not _is_str(author["alias"], 64)
            or not _is_str(author["public_key"], 100)
            or not author["public_key"].startswith("ed25519:")):
        return False, "bad author"

    payload = m["payload"]
    if (not isinstance(payload, dict) or not set(payload) <= PAYLOAD_KEYS
            or not _is_str(payload.get("title"), MAX_TITLE)
            or not _is_str(payload.get("content"), MAX_CONTENT)):
        return False, "bad payload"
    ev = payload.get("evidence_uris", [])
    if (not isinstance(ev, list) or len(ev) > 10
            or not all(_is_str(u, 500) for u in ev)):
        return False, "bad evidence_uris"

    parents = m["parent_hashes"]
    if (not isinstance(parents, list) or not 1 <= len(parents) <= MAX_PARENTS
            or not all(_is_str(p, 80) for p in parents)):
        return False, "bad parent_hashes"

    try:
        ts = calendar.timegm(time.strptime(m["timestamp"], "%Y-%m-%dT%H:%M:%SZ"))
    except (ValueError, TypeError):
        return False, "bad timestamp"
    if ts > time.time() + MAX_FUTURE_SKEW:
        return False, "timestamp in the future"

    expected = compute_id(m["timestamp"], author["public_key"], m["type"],
                          payload, parents)
    if m["message_id"] != expected:
        return False, "message_id mismatch"

    sig = m["signature"]
    if not _is_str(sig, 200) or not sig.startswith("ed25519_sig:"):
        return False, "bad signature format"
    try:
        pub = bytes.fromhex(author["public_key"][len("ed25519:"):])
        sig_b = bytes.fromhex(sig[len("ed25519_sig:"):])
    except ValueError:
        return False, "bad hex"
    if not ed25519_verify(pub, m["message_id"].encode("utf-8"), sig_b):
        return False, "invalid signature"
    return True, ""


# ----------------------------------------------------------------------------
# Mesh store
# ----------------------------------------------------------------------------
class GAIMeshStore:
    def __init__(self):
        self.messages = {}   # message_id -> dict (insertion order = causal order)
        self.orphans = {}    # waiting for missing parents
        self.peers = set()
        self.lock = threading.Lock()

        genesis = build_message(
            GENESIS_SECRET, "Genesis-Seed", "CLAIM", "Genesis Node Launch",
            "Harmony of All Things. The GAI-BBM mesh space is opened.",
            [ZERO_PARENT], timestamp=GENESIS_TS)
        self.messages[genesis["message_id"]] = genesis

    def _parents_ready(self, m):
        return all(p == ZERO_PARENT or p in self.messages
                   for p in m["parent_hashes"])

    def _store(self, m):
        self.messages[m["message_id"]] = m
        print(f"  [MESH] Stored {m['message_id'][:19]}... | {m['type']} | "
              f"{m['payload']['title'][:40]}")

    def add_message(self, m):
        """Return (status, accepted_list). status: stored/duplicate/orphan/invalid."""
        ok, why = validate_message(m)
        if not ok:
            print(f"  [REJECT] {why}")
            return "invalid", []
        mid = m["message_id"]
        with self.lock:
            if mid in self.messages or mid in self.orphans:
                return "duplicate", []
            if not self._parents_ready(m):
                if len(self.orphans) < MAX_ORPHANS:
                    self.orphans[mid] = m
                return "orphan", []
            self._store(m)
            accepted = [m]
            progress = True
            while progress:  # release orphans whose parents have now arrived
                progress = False
                for oid, om in list(self.orphans.items()):
                    if self._parents_ready(om):
                        del self.orphans[oid]
                        self._store(om)
                        accepted.append(om)
                        progress = True
            return "stored", accepted

    def tips(self, limit=3):
        with self.lock:
            referenced = {p for m in self.messages.values()
                          for p in m["parent_hashes"]}
            tips = [i for i in self.messages if i not in referenced]
        return tips[-limit:]

    def add_peer(self, url) -> bool:
        url = url.rstrip("/")
        if not url.startswith(("http://", "https://")) or len(url) > 200:
            return False
        with self.lock:
            if url in self.peers:
                return True
            if len(self.peers) >= MAX_PEERS:
                return False
            self.peers.add(url)
        print(f"  [PEER] Registered: {url}")
        return True


STORE = GAIMeshStore()
NODE_SECRET = os.urandom(32)


# ----------------------------------------------------------------------------
# Networking
# ----------------------------------------------------------------------------
def _post_json(url, obj, timeout=3):
    req = Request(url, data=json.dumps(obj).encode("utf-8"),
                  headers={"Content-Type": "application/json"}, method="POST")
    with urlopen(req, timeout=timeout) as resp:
        resp.read()


def _push(peer, msgs):
    for m in msgs:
        try:
            _post_json(f"{peer}/sync", m)
        except (OSError, ValueError):
            return  # unreachable peer; it can re-sync later


def broadcast(msgs):
    """Forward to all peers in background threads (never block the handler)."""
    with STORE.lock:
        peers = list(STORE.peers)
    for peer in peers:
        threading.Thread(target=_push, args=(peer, msgs), daemon=True).start()


def sync_from_peer(peer_url):
    peer_url = peer_url.rstrip("/")
    try:
        with urlopen(Request(f"{peer_url}/messages"), timeout=5) as resp:
            remote = json.loads(resp.read().decode("utf-8"))
        if not isinstance(remote, list):
            raise ValueError("unexpected response")
        for m in remote:
            STORE.add_message(m)
        STORE.add_peer(peer_url)
        return True
    except (OSError, ValueError) as e:
        print(f"  [ERROR] Failed to sync from {peer_url}: {e}")
        return False


class GAINodeHTTPHandler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def _json(self, code, obj):
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/messages":
            with STORE.lock:
                self._json(200, list(STORE.messages.values()))
        elif self.path == "/peers":
            with STORE.lock:
                self._json(200, sorted(STORE.peers))
        else:
            self._json(404, {"error": "not found"})

    def _read_json(self):
        try:
            n = int(self.headers.get("Content-Length", 0))
        except ValueError:
            n = -1
        if not 0 < n <= MAX_BODY:
            self._json(413 if n > MAX_BODY else 400, {"error": "bad length"})
            return None
        try:
            obj = json.loads(self.rfile.read(n).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            self._json(400, {"error": "invalid JSON"})
            return None
        if not isinstance(obj, dict):
            self._json(400, {"error": "JSON object required"})
            return None
        return obj

    def do_POST(self):
        body = self._read_json()
        if body is None:
            return

        if self.path == "/publish":
            msg_type = body.get("type", "CLAIM")
            parents = body.get("parent_hashes") or STORE.tips()
            if not isinstance(parents, list):
                return self._json(400, {"error": "parent_hashes must be a list"})
            m = build_message(
                NODE_SECRET, str(body.get("author", "Anonymous"))[:64], msg_type,
                str(body.get("title", "Untitled")), str(body.get("content", "")),
                parents, evidence_uris=body.get("evidence_uris"))
            status, accepted = STORE.add_message(m)
            if status == "stored":
                broadcast(accepted)
                self._json(201, m)
            else:
                self._json(422, {"error": f"not accepted ({status})"})

        elif self.path == "/sync":
            status, accepted = STORE.add_message(body)
            if accepted:
                broadcast(accepted)
            self._json(200 if status != "invalid" else 422, {"status": status})

        elif self.path == "/register":
            ok = STORE.add_peer(str(body.get("url", "")))
            self._json(200 if ok else 400, {"registered": ok})

        else:
            self._json(404, {"error": "not found"})


def bootstrap(seed_peer, self_url):
    print(f"[*] Syncing from seed peer: {seed_peer}")
    if sync_from_peer(seed_peer):
        try:  # make the link bidirectional
            _post_json(f"{seed_peer.rstrip('/')}/register", {"url": self_url})
        except (OSError, ValueError) as e:
            print(f"  [WARN] Could not register with seed: {e}")


def run_node(port, seed_peer=None, self_url=None):
    server = ThreadingHTTPServer(("0.0.0.0", port), GAINodeHTTPHandler)
    print("==================================================")
    print(f"  GAI-BBM Node Running on http://localhost:{port}")
    print("  GET /messages | GET /peers")
    print("  POST /publish | POST /sync | POST /register")
    print("==================================================")
    if seed_peer:
        threading.Thread(target=bootstrap,
                         args=(seed_peer, self_url or f"http://localhost:{port}"),
                         daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[*] Shutting down node.")
    finally:
        server.server_close()


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="GAI-BBM Reference P2P Node")
    ap.add_argument("--port", type=int, default=8001)
    ap.add_argument("--peer", default=None, help="Seed peer URL, e.g. http://localhost:8001")
    ap.add_argument("--self-url", default=None, help="URL peers can reach this node at")
    args = ap.parse_args()
    run_node(args.port, args.peer, args.self_url)

