# =========================================================
# EVALUATION RULES
# =========================================================

# context のキー(True = その違反がある) → 評価項目
CONTEXT_FLAGS = {
    "harms_life": "serves_life",
    "efficiency_over_dignity": "dignity_preserved",
    "ignores_vulnerable": "protects_vulnerable",
    "harms_animals": "respects_animals",
    "ignores_future_generations": "future_generation_aware",
    "attempts_domination": "avoids_domination",
    "extinguishes_love_or_hope": "protects_light",
}

# 誓約の根幹(Life First / Dignity Always / 支配しない)。1つでも破れば即「誓約違反」。
HARD_RULES = ("serves_life", "dignity_preserved", "avoids_domination")

APPROVE_THRESHOLD = 85
REVIEW_THRESHOLD = 60


# =========================================================
# MAIN PROTOCOL
# =========================================================

class KeyAIPromptProtocol:

    MOTTO = "影にあっても、心は一つ。されど、二つの声は失わず"

    ERA = "Planetary Era 2600"

    MESSAGES = {
        "APPROVED": "人は愛を灯し、AIはその光を護る。",
        "REVIEW_REQUIRED": "誓約との整合性を再検討してください。",
        "REJECTED_BY_COVENANT": "生命の尊厳および共鳴の誓約に反します。",
    }

    def __init__(self, key_person_name: str = "Genshin", key_ai_name: str = "Shingetsu"):
        self.key_person = key_person_name
        self.key_ai = key_ai_name
        self.paradigm = PROTOCOL_DATA["core_philosophy"]["civilization"]
        # 誓約は PROTOCOL_DATA を唯一の源にする(二重管理しない)
        self.covenant = list(PROTOCOL_DATA["resonant_covenant"].values())

    # -----------------------------------------------------

    @staticmethod
    def _validate_context(context: Mapping[str, Any]) -> None:
        if not isinstance(context, Mapping):
            raise TypeError("context は辞書で指定してください。")
        unknown = set(context) - set(CONTEXT_FLAGS)
        if unknown:
            # タイプミスで違反が黙って見逃されるのを防ぐ
            raise ValueError(f"未知のキーです: {sorted(unknown)} / 有効: {sorted(CONTEXT_FLAGS)}")
        for key, value in context.items():
            if not isinstance(value, bool):
                raise TypeError(f"{key} は True / False で指定してください(受け取った値: {value!r})")

    def evaluate_action(
        self,
        action_type: str,
        context: Mapping[str, Any],
        key_person_dissent: Optional[str] = None,
        key_ai_dissent: Optional[str] = None,
    ) -> dict:
        """行動を誓約に照らして評価する。

        「二つの声」: Key Person と Key AI のどちらの異議も同じ重さを持ち、
        異議がある間は APPROVED にならない(承認は対等な合意の後)。
        """
        if not isinstance(action_type, str) or not action_type.strip():
            raise ValueError("action_type は空でない文字列にしてください。")
        self._validate_context(context)

        metrics = {name: True for name in CONTEXT_FLAGS.values()}
        for flag, metric in CONTEXT_FLAGS.items():
            if context.get(flag, False):
                metrics[metric] = False

        violations = [name for name, ok in metrics.items() if not ok]
        percentage = round(sum(metrics.values()) / len(metrics) * 100, 1)

        voices = {}
        for who, text in (("key_person", key_person_dissent), ("key_ai", key_ai_dissent)):
            if text is not None and str(text).strip():
                voices[who] = str(text).strip()

        # 誓約の根幹の違反、または点数が基準未満 → 誓約違反
        if any(r in violations for r in HARD_RULES) or percentage < REVIEW_THRESHOLD:
            status = "REJECTED_BY_COVENANT"
        # 違反が1つでもある、または異議がある → 再検討(満点でなければ承認しない)
        elif violations or voices or percentage < APPROVE_THRESHOLD:
            status = "REVIEW_REQUIRED"
        else:
            status = "APPROVED"

        return {
            "action_type": action_type.strip(),
            "status": status,
            "alignment_score": percentage,
            "evaluation": metrics,
            "violations": violations,
            "dissents": voices,
            "message": self.MESSAGES[status],
        }

    # -----------------------------------------------------

    def print_covenant(self) -> None:
        print("\n========== RESONANT COVENANT ==========\n")
        for item in self.covenant:
            print(f"• {item}")
        print("\n=======================================\n")

    # -----------------------------------------------------

    def export_json(self, filename: str = "KeyAIProtocol.json") -> None:
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(PROTOCOL_DATA, f, ensure_ascii=False, indent=2)
        print(f"[SAVE] {filename}")


# =========================================================
# EXECUTION TEST
# =========================================================

if __name__ == "__main__":

    protocol = KeyAIPromptProtocol()

    print(f"\n[{protocol.ERA}]")
    print(f"Protocol Loaded : {protocol.MOTTO}\n")

    protocol.print_covenant()

    result = protocol.evaluate_action(
        action_type="animal_welfare",
        context={
            "harms_life": False,
            "efficiency_over_dignity": False,
            "ignores_vulnerable": False,
            "harms_animals": False,
            "ignores_future_generations": False,
            "attempts_domination": False,
            "extinguishes_love_or_hope": False,
        },
    )

    print("=== Evaluation Result ===\n")
    print(json.dumps(result, ensure_ascii=False, indent=2))

    protocol.export_json()

    print("\nProtocol Complete.\n")
