### ライブラリとして使う

```python
from genshin_sekai_ni_geki_suru import (
    Bi, Shiso, Gijutsu, Hashi, kakeru, shinka, shiken, KamiNiSuruna,
)

# 思想 + 実装
idea = Shiso("私の思想", Bi("私の思想", "my idea"))
tech = Gijutsu("私のコード", works=True, usable=True, spreadable=True)
print(shinka(idea, tech)("ja"))

