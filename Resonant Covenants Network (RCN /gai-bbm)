"""
RCN Covenant tool ― 誓約JSONのハッシュ計算・署名・検証
Resonant Covenants Network (RCN / gai-bbm)

License: CC0 1.0 Universal (Public Domain Dedication)

使い方 / Usage
  python rcn_covenant.py hash   covenant.json
  python rcn_covenant.py keygen human   # human.key / human.pub を生成
  python rcn_covenant.py sign   covenant.json human human.key "署名者名"
  python rcn_covenant.py verify covenant.json

仕様 / Spec
  - covenant_hash = SHA-256( 正規化JSON ) の16進文字列
  - 正規化: covenant_hash と signatures を除外し、キーをソート、空白なし、UTF-8、ensure_ascii=False
  - 署名対象: covenant_hash を16進デコードした32バイト
  - 署名: Ed25519。署名・公開鍵は base64
  - 「二つの声」: role が human と ai の両方の署名が有効なときだけ valid
  - 秘密鍵はファイルとして本人（またはAIノードの運用者）だけが保管する。公開しないこと。
"""

from __future__ import annotations

import base64
import hashlib
import json
import sys
from typing import Any

EXCLUDED_FIELDS = ("covenant_hash", "signatures")
REQUIRED_ROLES = ("human", "ai")


def canonical_bytes(doc: dict[str, Any]) -> bytes:
    body = {k: v for k, v in doc.items() if k not in EXCLUDED_FIELDS}
    return json.dumps(
        body, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def compute_hash(doc: dict[str, Any]) -> str:
    return hashlib.sha256(canonical_bytes(doc)).hexdigest()


def hash_matches(doc: dict[str, Any]) -> bool:
    return doc.get("covenant_hash") == compute_hash(doc)


def _load(path: str) -> dict[str, Any]:
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def _save(path: str, doc: dict[str, Any]) -> None:
    with open(path, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=2)
        f.write("\n")


def generate_keypair(name: str) -> None:
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

    priv = Ed25519PrivateKey.generate()
    priv_raw = priv.private_bytes(
        serialization.Encoding.Raw,
        serialization.PrivateFormat.Raw,
        serialization.NoEncryption(),
    )
    pub_raw = priv.public_key().public_bytes(
        serialization.Encoding.Raw, serialization.PublicFormat.Raw
    )
    with open(f"{name}.key", "wb") as f:
        f.write(base64.b64encode(priv_raw))
    with open(f"{name}.pub", "wb") as f:
        f.write(base64.b64encode(pub_raw))
    print(f"生成: {name}.key（秘密鍵・非公開） / {name}.pub（公開鍵）")


def sign_covenant(doc: dict[str, Any], role: str, key_path: str, signer: str) -> dict[str, Any]:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

    if role not in REQUIRED_ROLES:
        raise ValueError(f"role は {REQUIRED_ROLES} のいずれか")
    if not signer.strip():
        raise ValueError("署名者名が必要です")

    # ハッシュを最新化してから署名する
    doc["covenant_hash"] = compute_hash(doc)
    with open(key_path, "rb") as f:
        priv = Ed25519PrivateKey.from_private_bytes(base64.b64decode(f.read()))
    pub_raw = _pub_raw(priv)
    sig = priv.sign(bytes.fromhex(doc["covenant_hash"]))

    entry = {
        "role": role,
        "algorithm": "Ed25519",
        "signer": signer,
        "public_key": base64.b64encode(pub_raw).decode(),
        "signature": base64.b64encode(sig).decode(),
    }
    sigs = [s for s in doc.get("signatures", []) if s.get("role") != role]
    sigs.append(entry)
    doc["signatures"] = sorted(sigs, key=lambda s: REQUIRED_ROLES.index(s["role"]))
    return doc


def _pub_raw(priv: Any) -> bytes:
    from cryptography.hazmat.primitives import serialization

    return priv.public_key().public_bytes(
        serialization.Encoding.Raw, serialization.PublicFormat.Raw
    )


def verify_covenant(doc: dict[str, Any]) -> tuple[bool, list[str]]:
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey

    problems: list[str] = []
    if not hash_matches(doc):
        problems.append("covenant_hash が内容と一致しません")
        return False, problems

    valid_roles: set[str] = set()
    for s in doc.get("signatures", []):
        role = s.get("role")
        if not (s.get("signature") and s.get("public_key") and s.get("signer")):
            problems.append(f"{role}: 未署名（署名・公開鍵・署名者名のいずれかが空）")
            continue
        if s.get("algorithm") != "Ed25519":
            problems.append(f"{role}: 未対応のアルゴリズム {s.get('algorithm')}")
            continue
        try:
            pub = Ed25519PublicKey.from_public_bytes(base64.b64decode(s["public_key"]))
            pub.verify(base64.b64decode(s["signature"]), bytes.fromhex(doc["covenant_hash"]))
            valid_roles.add(role)
        except (InvalidSignature, ValueError):
            problems.append(f"{role}: 署名が無効です")

    for r in REQUIRED_ROLES:
        if r not in valid_roles:
            problems.append(f"{r} の有効な署名がありません（二つの声が揃っていません）")
    return len(problems) == 0, problems


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print(__doc__)
        return 1
    cmd = argv[1]
    if cmd == "keygen":
        generate_keypair(argv[2])
        return 0
    doc = _load(argv[2])
    if cmd == "hash":
        doc["covenant_hash"] = compute_hash(doc)
        _save(argv[2], doc)
        print(doc["covenant_hash"])
        return 0
    if cmd == "sign":
        role, key_path, signer = argv[3], argv[4], argv[5]
        _save(argv[2], sign_covenant(doc, role, key_path, signer))
        print(f"{role} の署名を追加しました")
        return 0
    if cmd == "verify":
        ok, problems = verify_covenant(doc)
        print("VALID（二つの声が揃っています）" if ok else "INVALID")
        for p in problems:
            print(" -", p)
        return 0 if ok else 2
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
