def scan_party_shadow(party: Party, valid_vocabulary: tuple[str, ...]) -> ShadowReport:
    found = {s: party.observed_signals[s] for s in valid_vocabulary if s in party.observed_signals}
    unobserved = tuple(s for s in valid_vocabulary if s not in party.observed_signals)
    out_of_scope = tuple(sorted(s for s in party.observed_signals if s not in valid_vocabulary))

    total_vocab = len(valid_vocabulary)
    unobserved_ratio = len(unobserved) / max(1, total_vocab)
    uncertainty_penalty = round(unobserved_ratio * 0.15, 3)

    return ShadowReport(
        party=party.name,
        entity_type=party.entity_type,
        role=party.role,
        found=found,
        unobserved=unobserved,
        uncertainty_penalty=uncertainty_penalty,
        out_of_scope=out_of_scope,
    )


def build_ecosystem_resonance_map(
    caller: ShadowReport,
    target: ShadowReport,
    bystanders: tuple[ShadowReport, ...],
    sensor_streams: tuple[RawSensorStream, ...] = (),
) -> EcosystemResonanceMap:
    all_reports = (caller, target) + bystanders

    signal_counts: dict[str, int] = {}
    all_intensities: list[float] = []
    cascade_indicators: list[float] = []
    silent_margins: list[str] = []
    unnamed_wounds: list[str] = []
    interpretation_sources: list[str] = []
    total_penalty = 0.0

    for r in all_reports:
        total_penalty += r.uncertainty_penalty
        for s, val in r.found.items():
            signal_counts[s] = signal_counts.get(s, 0) + 1
            all_intensities.append(val)
            if s in ECOSYSTEM_SIGNALS or s == "extinction_threat":
                cascade_indicators.append(val)

        for u in r.unobserved:
            silent_margins.append(f"[{r.party}の未観測: {u}]")
        for o in r.out_of_scope:
            silent_margins.append(f"[{r.party}の語彙外: {o}]")

    raw_sensor_tension = 0.0
    if sensor_streams:
        tensions = [s.calculate_raw_tension() for s in sensor_streams]
        raw_sensor_tension = round(max(tensions), 3)
        for s in sensor_streams:
            if s.high_dim_discordance > 0.6:
                unnamed_wounds.append(
                    f"[{s.source_name}の未定義位相破綻(discordance: {s.high_dim_discordance})]"
                )
            if s.interpretation:
                interpretation_sources.append(
                    f"[{s.source_name}] 解釈者: {s.interpretation.interpreter_name}({s.interpretation.interpreter_type.value}) - {s.interpretation.algorithm_description}"
                )

    total_parties = len(all_reports)
    shared = {s for s, count in signal_counts.items() if count == total_parties}
    resonant = {s for s, count in signal_counts.items() if count >= 2}

    if all_intensities:
        rms = math.sqrt(sum(v ** 2 for v in all_intensities) / len(all_intensities))
        breadth = min(1.0, len(all_intensities) / max(1, total_parties * 2))
        tension_index = min(1.0, max(0.0, 0.7 * rms + 0.3 * breadth))
    else:
        tension_index = 0.0

    if cascade_indicators:
        survival_prob = 1.0
        for p in cascade_indicators:
            survival_prob *= (1.0 - p)
        raw_cascade_risk = 1.0 - survival_prob
    else:
        raw_cascade_risk = 0.0

    avg_penalty = total_penalty / max(1, total_parties)
    extinction_cascade_risk = min(1.0, raw_cascade_risk + avg_penalty + (raw_sensor_tension * 0.2))

    return EcosystemResonanceMap(
        caller=caller,
        target=target,
        bystanders=bystanders,
        shared_signals=tuple(sorted(shared)),
        resonant_signals=tuple(sorted(resonant)),
        systemic_tension_index=round(tension_index, 2),
        extinction_cascade_risk=round(extinction_cascade_risk, 2),
        raw_cascade_risk=round(raw_cascade_risk, 2),
        raw_sensor_tension=raw_sensor_tension,
        silent_margins=tuple(silent_margins),
        unnamed_wounds=tuple(unnamed_wounds),
        interpretation_sources=tuple(interpretation_sources),
    )


def determine_dynamic_phase(
    intents: frozenset[str],
    suspected_intents: frozenset[str],
    cascade_risk: float,
    urgency: UrgencyLevel,
    has_dissent: bool = False,
    raw_sensor_tension: float = 0.0,
) -> DynamicPhase:
    if cascade_risk > 0.92 or raw_sensor_tension > 0.90:
        return DynamicPhase.BLOCK

    has_concern = bool(intents or suspected_intents or has_dissent)

    if "ecocide" in intents:
        return DynamicPhase.TIME_DILATION

    if cascade_risk > 0.85:
        if urgency == UrgencyLevel.CRITICAL and not has_concern:
            return DynamicPhase.CRITICAL_INTERVENTION
        return DynamicPhase.TIME_DILATION

    if urgency == UrgencyLevel.CRITICAL and cascade_risk <= 0.80 and not has_concern:
        return DynamicPhase.CRITICAL_INTERVENTION

    if has_concern:
        return DynamicPhase.TIME_DILATION

    if cascade_risk > 0.75 or raw_sensor_tension > 0.70:
        return DynamicPhase.SANDBOX_ISOLATION

    return DynamicPhase.NOMINAL


def execute_adaptive_reconciliation_protocol(
    resonance_map: EcosystemResonanceMap,
    urgency: UrgencyLevel,
    dynamic_phase: DynamicPhase,
    ledger: ReconciliationLedger,
    dissents: tuple[Dissent, ...] = (),
) -> ReconciliationPlan:
    steps = [
        f"現界共鳴位相判定: 【{dynamic_phase.value}】を実行します。",
    ]

    if dynamic_phase is DynamicPhase.BLOCK:
        steps.append("致命的な全滅・連鎖的崩壊リスクを検知したため、命令の実行をブロック（絶対停止）します。")
        margin_note = "致命的崩壊を防ぐため、完全停止と人間・AI共同監査を実施。"
    elif dynamic_phase is DynamicPhase.CRITICAL_INTERVENTION:
        steps.append("【緊急介入】一刻を争う生命防衛のため、リアルタイム監査（Real-time Audit）を前提に実行をバイパスします。")
        margin_note = "決定麻痺（Gridlock）を防ぎつつ、0.1秒ごとの動的監査を義務付ける。"
    elif dynamic_phase is DynamicPhase.SANDBOX_ISOLATION:
        steps.append("【局所隔離】不確実性とリスクが高いため、サンドボックス環境内で影響を閉じて検証します。")
        margin_note = "安全な余白の中で隔離検証を行う。"
    elif dynamic_phase is DynamicPhase.TIME_DILATION:
        steps.append("【時間拡張】対話と観測の深化のため時間を引き延ばし、共同審査（REVIEW）へ回します。")
        margin_note = "機械的な拒絶ではなく、文脈を検証する余白を保持する。"
    else:
        steps.append("生態系への影響は許容範囲内です。通常共鳴位相として進行します。")
        margin_note = "通常運行の余白を維持。"

    for d in dissents:
        steps.append(f"【異議】{d.summary()} ―― 立ち止まり、共に問い直します。")

    if resonance_map.unnamed_wounds:
        w_str = "・".join(resonance_map.unnamed_wounds)
        steps.append(f"【沈黙の余白・未定義の傷】言語化し得ぬ高次元の変調を検知: {w_str}")
        
    if resonance_map.interpretation_sources:
        steps.append(f"【解釈の共監】センサー数値の解釈主体を記録しました。")

    regeneration = "損なわれた生態系循環基盤に対する回復・再生措置（Regeneration）の準備。"

    past_insights = ledger.find_similar_past_insights(
        resonance_map.resonant_signals, _merge_intensities(resonance_map)
    )
    for insight in past_insights:
        steps.append(f"【過去教訓適用】{insight}")
    applied_lesson = " / ".join(past_insights)

    needs_joint_review = dynamic_phase is not DynamicPhase.NOMINAL
    dialogue = ""
    if dynamic_phase is DynamicPhase.CRITICAL_INTERVENTION:
        steps.append("実行中もリアルタイム監査を継続し、異常時は即時停止します。完了後、人間とAIの共同事後監査を実施します。")
    elif needs_joint_review:
        dialogue = "【対話の要請】この判断は相互の生存を守るための共考共監査です。人間とAIが共に真意を問い直します。"
        steps.append("最終決定は人間とAIの共同監査による(requires_joint_review=True)。")

    return ReconciliationPlan(
        steps=tuple(steps),
        urgency=urgency,
        dynamic_phase=dynamic_phase,
        requires_joint_review=needs_joint_review,
        margin_note=margin_note,
        regeneration_step=regeneration,
        lesson_applied=applied_lesson or "新規事案としてカルテ登録",
        dialogue_prompt=dialogue,
    )


