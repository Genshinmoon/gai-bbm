def _merge_intensities(resonance_map: EcosystemResonanceMap) -> dict[str, float]:
    merged: dict[str, float] = {}
    for r in (resonance_map.caller, resonance_map.target) + resonance_map.bystanders:
        for s, v in r.found.items():
            merged[s] = max(v, merged.get(s, 0.0))
    return merged


class ReconciliationLedger:
    def __init__(self, max_records: int = 1000, store_command_text: bool = True) -> None:
        if max_records < 1:
            raise ValueError("max_records must be >= 1")
        self._history: deque[ReconciliationRecord] = deque(maxlen=max_records)
        self.max_records = max_records
        self.store_command_text = store_command_text

    def record(
        self,
        command_text: str,
        intents: frozenset[str],
        suspected_intents: frozenset[str],
        resonance_map: EcosystemResonanceMap,
        plan: ReconciliationPlan,
        dissents: tuple[Dissent, ...] = (),
        lesson_learned: str = "",
        verifiers: tuple[Signature, ...] = (),
    ) -> ReconciliationRecord:
        rec = ReconciliationRecord(
            record_id=str(uuid.uuid4()),
            timestamp=time.time(),
            command_text=command_text if self.store_command_text else None,
            intents=tuple(sorted(intents)),
            suspected_intents=tuple(sorted(suspected_intents)),
            dissents=tuple(d.summary() for d in dissents),
            shared_signals=resonance_map.shared_signals,
            resonant_signals=resonance_map.resonant_signals,
            signal_intensities=_merge_intensities(resonance_map),
            silent_margins=resonance_map.silent_margins,
            unnamed_wounds=resonance_map.unnamed_wounds,
            interpretation_sources=resonance_map.interpretation_sources,
            urgency=plan.urgency.value,
            dynamic_phase=plan.dynamic_phase.value,
            plan_summary=plan.steps,
            lesson_learned=lesson_learned,
            verifiers=tuple(verifiers),
        )
        self._history.append(rec)
        return rec

    def get(self, record_id: str) -> Optional[ReconciliationRecord]:
        for rec in self._history:
            if rec.record_id == record_id:
                return rec
        return None

    def records(self) -> tuple[ReconciliationRecord, ...]:
        return tuple(self._history)

    def load_records(self, records: "list[ReconciliationRecord]") -> None:
        for r in records:
            self._history.append(r)

    def sign_record(self, record_id: str, lesson: str, signer: Signature) -> bool:
        lesson = _require_text("lesson", lesson)
        for i, rec in enumerate(self._history):
            if rec.record_id != record_id:
                continue
            if lesson != rec.lesson_learned:
                history = rec.lesson_history
                if rec.lesson_learned:
                    history = history + (rec.lesson_learned,)
                self._history[i] = replace(
                    rec, lesson_learned=lesson, verifiers=(signer,), lesson_history=history
                )
            elif signer not in rec.verifiers:
                self._history[i] = replace(rec, verifiers=rec.verifiers + (signer,))
            return True
        return False

    def find_similar_past_insights(
        self,
        current_resonant: tuple[str, ...],
        current_intensities: Mapping[str, float],
        threshold: float = 0.5,
    ) -> list[str]:
        scored: list[tuple[float, str]] = []
        current_set = set(current_resonant)
        for rec in self._history:
            if not rec.is_verified:
                continue
            overlap = current_set & set(rec.resonant_signals)
            if not overlap:
                continue
            match_score = sum(
                1.0 - abs(current_intensities.get(s, 0.0) - rec.signal_intensities.get(s, 0.0))
                for s in overlap
            ) / len(overlap)
            if match_score >= threshold:
                signers = "・".join(f"{s.name}({s.entity_type.value})" for s in rec.verifiers)
                scored.append((
                    match_score,
                    f"過去カルテ [検証済教訓 / 署名: {signers} / "
                    f"一致度: {match_score:.2f} / 傷: {'・'.join(sorted(overlap))}]: {rec.lesson_learned}",
                ))
        scored.sort(key=lambda x: x[0], reverse=True)
        return [text for _, text in scored[:MAX_PAST_INSIGHTS]]


