def _validate_intensity(signal: str, value: float) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ValueError(f"{signal}: intensity must be a number")
    if math.isnan(value) or not (0.0 <= value <= 1.0):
        raise ValueError(f"{signal}: intensity must be between 0.0 and 1.0, got {value}")
    return float(value)


def _require_text(label: str, value: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{label} must be a non-empty string")
    return value.strip()


