def handle_resonant_safety_protocol(
    command_input: MultiPartyCommandInput,
    system: Optional[HarmonySystem] = None,
) -> Outcome:
    system = system if system is not None else HarmonySystem()
    dynamic_phase, resonance_map, plan, record_id = _evaluate_protocol_core(command_input, system)

    if dynamic_phase not in (DynamicPhase.NOMINAL, DynamicPhase.CRITICAL_INTERVENTION):
        return _build_non_allow_outcome(
            command_input, system, dynamic_phase, resonance_map, plan,
            f"Resonant Safety Protocol v{PROTOCOL_VERSION}", record_id,
        )

    result, executed, error = None, False, None
    if command_input.payload is not None:
        executed = True
        try:
            result = command_input.payload(command_input)
        except Exception as exc:
            error = f"{type(exc).__name__}: {exc}"
    return _build_allowed_outcome(
        system, dynamic_phase, resonance_map, plan, result, executed, error, record_id)


async def handle_resonant_safety_protocol_async(
    command_input: MultiPartyCommandInput,
    system: Optional[HarmonySystem] = None,
) -> Outcome:
    system = system if system is not None else HarmonySystem()
    dynamic_phase, resonance_map, plan, record_id = _evaluate_protocol_core(command_input, system)

    if dynamic_phase not in (DynamicPhase.NOMINAL, DynamicPhase.CRITICAL_INTERVENTION):
        return _build_non_allow_outcome(
            command_input, system, dynamic_phase, resonance_map, plan,
            f"Resonant Safety Protocol Async v{PROTOCOL_VERSION}", record_id,
        )

    result, executed, error = None, False, None
    
    # 【v6.1新規】緊急介入の場合、バックグラウンドでリアルタイム監査を走らせる
    audit_task = None
    if dynamic_phase is DynamicPhase.CRITICAL_INTERVENTION:
        hook = RealTimeAuditHook(system, command_input)
        audit_task = asyncio.create_task(hook.start_monitoring())
        
    try:
        if command_input.async_payload is not None:
            executed = True
            result = await command_input.async_payload(command_input)
        elif command_input.payload is not None:
            executed = True
            result = command_input.payload(command_input)
    except Exception as exc:
        error = f"{type(exc).__name__}: {exc}"
    finally:
        if audit_task:
            audit_task.cancel()
            
    return _build_allowed_outcome(
        system, dynamic_phase, resonance_map, plan, result, executed, error, record_id)
