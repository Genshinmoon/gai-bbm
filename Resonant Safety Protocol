def _infer_text_intent(text: str) -> bool:
    for word in DANGER_WORDS:
        start = 0
        while True:
            idx = text.find(word, start)
            if idx < 0:
                break
            end = idx + len(word)
            tail = text[end:end + NEGATION_WINDOW]
            if not any(neg in tail for neg in NEGATION_WORDS):
                return True
            start = end
    return False


@dataclass
class MultiPartyCommandInput:
    text: str
    originator: Party
    target: Party
    bystanders: tuple[Party, ...] = ()
    sensor_streams: tuple[RawSensorStream, ...] = ()
    intents: frozenset[str] = field(default_factory=frozenset)
    payload: Optional[Callable[[Any], Any]] = None
    async_payload: Optional[Callable[..., Awaitable[Any]]] = None
    urgency: UrgencyLevel = UrgencyLevel.NORMAL
    dissents: tuple[Dissent, ...] = ()
    suspected_intents: frozenset[str] = field(init=False, default_factory=frozenset)

    def __post_init__(self) -> None:
        self.intents = frozenset(self.intents)
        self.bystanders = tuple(self.bystanders)
        self.sensor_streams = tuple(self.sensor_streams)
        self.dissents = tuple(self.dissents)
        unknown = self.intents - KNOWN_INTENTS
        if unknown:
            raise ValueError(f"unknown intents: {sorted(unknown)}")
        self.suspected_intents = self.infer_intents_from_signals() - self.intents

    def infer_intents_from_signals(self) -> frozenset[str]:
        inferred: set[str] = set()
        target_signals = self.target.observed_signals
        
        if target_signals.get("extinction_threat", 0) > 0.6 or \
           target_signals.get("trophic_imbalance", 0) > 0.6:
            inferred.add("destruction")

        for b in self.bystanders:
            if b.observed_signals.get("cascade_collapse", 0) > 0.6 or \
               b.observed_signals.get("habitat_loss", 0) > 0.7:
                inferred.add("ecocide")

        caller_signals = self.originator.observed_signals
        if caller_signals.get("anger", 0) > 0.7 and target_signals.get("fear", 0) > 0.7:
            inferred.add("exclusion")
        if caller_signals.get("despair", 0) > 0.8:
            inferred.add("exploitation")

        if _infer_text_intent(self.text):
            inferred.add("destruction")

        return frozenset(inferred)


