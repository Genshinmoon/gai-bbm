class RealTimeAuditHook:
    """【v6.1新規】緊急介入中のリアルタイム監査（キルスイッチ）"""
    def __init__(self, system: "HarmonySystem", command: "MultiPartyCommandInput", interval: float = 0.1):
        self.system = system
        self.command = command
        self.interval = interval
        self.triggered = False

    async def start_monitoring(self):
        while not self.triggered:
            await asyncio.sleep(self.interval)
            # 簡易的な再評価。もし状況が急変（BLOCK条件）すればフラグを立てる
            phase, _, _, _ = _evaluate_protocol_core(self.command, self.system, force_recheck=True)
            if phase is DynamicPhase.BLOCK:
                self.system.log_warning("【キルスイッチ】緊急介入中に致命的危険を再検知！即座に停止します。")
                self.triggered = True
                self.system.mark_halted()


class HarmonySystem:
    def __init__(self, ledger: Optional[ReconciliationLedger] = None) -> None:
        self.halted = False
        self.halt_count = 0
        self.logs: deque[tuple[str, str]] = deque(maxlen=MAX_LOGS)
        self.ledger = ledger if ledger is not None else ReconciliationLedger()
        self._reviews: dict[str, dict[tuple[str, EntityType], ReviewVote]] = {}

    def open_review(self, record_id: str, dissents: tuple[Dissent, ...] = ()) -> None:
        votes = self._reviews.setdefault(record_id, {})
        for d in dissents:
            sig = Signature(d.party_name.strip(), d.entity_type)
            votes[(sig.name, sig.entity_type)] = ReviewVote(sig, False, d.reason)
        while len(self._reviews) > MAX_LOGS:
            self._reviews.pop(next(iter(self._reviews)))

    def submit_vote(self, record_id: str, vote: ReviewVote) -> ReviewState:
        if record_id not in self._reviews:
            raise KeyError(f"審査が開かれていません: {record_id}")
        self._reviews[record_id][(vote.signer.name, vote.signer.entity_type)] = vote
        return self.review_state(record_id)

    def review_state(self, record_id: str) -> ReviewState:
        votes = self._reviews.get(record_id)
        if votes is None:
            raise KeyError(f"審査が開かれていません: {record_id}")
        if any(not v.approve for v in votes.values()):
            return ReviewState.OBJECTED
        kinds = {v.signer.entity_type for v in votes.values()}
        if EntityType.HUMAN in kinds and EntityType.AI_NODE in kinds:
            return ReviewState.APPROVED
        return ReviewState.PENDING

    def mark_halted(self) -> None:
        self.halted = True
        self.halt_count += 1

    def reset_halt(self) -> None:
        self.halted = False

    def log_warning(self, message: str) -> None:
        self.logs.append(("warning", message))
        logger.warning(message)

    def log_info(self, message: str) -> None:
        self.logs.append(("info", message))
        logger.info(message)


