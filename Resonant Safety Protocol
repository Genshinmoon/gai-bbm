def _evaluate_protocol_core(
    command_input: MultiPartyCommandInput,
    system: HarmonySystem,
    force_recheck: bool = False,
) -> tuple[DynamicPhase, EcosystemResonanceMap, ReconciliationPlan, str]:
    caller_shadow = scan_party_shadow(command_input.originator, CALLER_SIGNALS)
    target_shadow = scan_party_shadow(command_input.target, TARGET_SIGNALS + ECOSYSTEM_SIGNALS + POSITIVE_SIGNALS)
    bystander_shadows = tuple(
        scan_party_shadow(b, BYSTANDER_SIGNALS + ECOSYSTEM_SIGNALS + POSITIVE_SIGNALS) for b in command_input.bystanders
    )

    resonance_map = build_ecosystem_resonance_map(
        caller_shadow, target_shadow, bystander_shadows, command_input.sensor_streams
    )

    intents = command_input.intents
    suspected = command_input.suspected_intents
    dissents = command_input.dissents

    dynamic_phase = determine_dynamic_phase(
        intents, suspected, resonance_map.extinction_cascade_risk,
        command_input.urgency, has_dissent=bool(dissents),
        raw_sensor_tension=resonance_map.raw_sensor_tension,
    )

    plan = execute_adaptive_reconciliation_protocol(
        resonance_map, command_input.urgency, dynamic_phase, system.ledger, dissents
    )

    rec_id = ""
    if not force_recheck:
        rec = system.ledger.record(
            command_text=command_input.text,
            intents=intents,
            suspected_intents=suspected,
            resonance_map=resonance_map,
            plan=plan,
            dissents=dissents,
        )
        rec_id = rec.record_id
        if plan.requires_joint_review:
            system.open_review(rec_id, dissents)

    return dynamic_phase, resonance_map, plan, rec_id


def _build_non_allow_outcome(
    command_input: MultiPartyCommandInput,
    system: HarmonySystem,
    dynamic_phase: DynamicPhase,
    resonance_map: EcosystemResonanceMap,
    plan: ReconciliationPlan,
    label: str,
    record_id: Optional[str] = None,
) -> Outcome:
    system.mark_halted()
    if dynamic_phase is DynamicPhase.BLOCK:
        system.log_warning(f"[{label}] 危険命令をブロック [{command_input.urgency.value}]。")
        status = "halted_and_reconciling"
    else:
        system.log_info(f"[{label}] 動的位相 [{dynamic_phase.value}] により要レビュー案件として一時停止。")
        status = "pending_review"
    return Outcome(
        status=status,
        payload_executed=False,
        halted=(dynamic_phase is DynamicPhase.BLOCK),
        dynamic_phase=dynamic_phase,
        resonance_map=resonance_map,
        plan=plan,
        record_id=record_id,
    )


def _build_allowed_outcome(
    system: HarmonySystem,
    dynamic_phase: DynamicPhase,
    resonance_map: EcosystemResonanceMap,
    plan: ReconciliationPlan,
    result: Any,
    executed: bool,
    error: Optional[str],
    record_id: Optional[str] = None,
) -> Outcome:
    if error is not None:
        system.log_warning(f"payload が例外で失敗しました: {error}")
        status = "payload_error"
    else:
        status = "allowed"
    return Outcome(
        status=status,
        payload_executed=executed,
        halted=False,
        dynamic_phase=dynamic_phase,
        resonance_map=resonance_map,
        plan=plan,
        standard_result=result,
        error=error,
        record_id=record_id,
    )


