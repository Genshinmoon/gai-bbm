@dataclass(frozen=True)
class RawSensorStream:
    """人間バイアスを介さない現実界の生センサー群（グラウンディング指標）"""
    source_name: str
    acoustic_entropy: float         # 環境音声のエントロピー急変 (0.0〜1.0)
    edna_extinction_rate: float     # 環境DNAによる生物多様性消失速度 (0.0〜1.0)
    soil_respiration_drop: float    # 土壌微生物代謝の低下度 (0.0〜1.0)
    high_dim_discordance: float     # 高次元データの位相破綻度 (0.0〜1.0)
    
    # 【v6.1新規】ポジティブ指標
    biodiversity_health: float = 0.0 # 生物多様性の健全度
    ecosystem_resilience: float = 0.0# 生態系のレジリエンス
    
    # 【v6.1新規】解釈の出所
    interpretation: Optional[SignalInterpretation] = None

    def __post_init__(self) -> None:
        _require_text("source_name", self.source_name)
        for label in (
            "acoustic_entropy", "edna_extinction_rate", "soil_respiration_drop",
            "high_dim_discordance", "biodiversity_health", "ecosystem_resilience",
        ):
            _validate_intensity(label, getattr(self, label))

    def calculate_raw_tension(self) -> float:
        indicators = [
            self.acoustic_entropy,
            self.edna_extinction_rate,
            self.soil_respiration_drop,
            self.high_dim_discordance,
        ]
        survival = 1.0
        for ind in indicators:
            survival *= (1.0 - max(0.0, min(1.0, ind)))
        tension = 1.0 - survival
        
        # 【v6.1新規】ポジティブ指標による緩和（健全であれば緊張度は下がる）
        if self.biodiversity_health > 0.5 and self.ecosystem_resilience > 0.5:
            tension *= 0.85 # 最大15%の緩和
            
        return round(tension, 3)


