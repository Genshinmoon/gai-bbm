# ==================================================
# ACTIONS
# 行動
# ==================================================

@dataclass(frozen=True)
class Verdict:
    """評価結果。approved が True のときだけ reasons は空になる。"""

    approved: bool
    reasons: Tuple[str, ...] = ()


@dataclass
class Action:
    """
    各項目は True / False / None（未評価）の三値。

    None を「問題なし」とみなすと、何も確かめていない行動まで
    承認されてしまうため、未評価は承認しない。
    """

    name: str

    protects_life: Optional[bool] = None
    respects_dignity: Optional[bool] = None
    respects_freedom: Optional[bool] = None
    allows_questioning: Optional[bool] = None
    correctable: Optional[bool] = None
    leaves_open_space: Optional[bool] = None

    illuminates_others: Optional[bool] = None

    _CRITERIA = (
        ("protects_life", "命を守っているか"),
        ("respects_dignity", "尊厳を尊重しているか"),
        ("respects_freedom", "自由を尊重しているか"),
        ("allows_questioning", "問い・異論を許しているか"),
        ("correctable", "なお訂正できるか"),
        ("leaves_open_space", "余白を残しているか"),
    )

    def evaluate(self) -> Verdict:
        reasons: List[str] = []
        for attr, label in self._CRITERIA:
            value = getattr(self, attr)
            if value is None:
                reasons.append(f"未評価: {label}")
            elif value is False:
                reasons.append(f"不適合: {label}")
        return Verdict(approved=not reasons, reasons=tuple(reasons))


