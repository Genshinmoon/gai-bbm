def _header(title: str) -> None:
    print(title)
    print("-" * 36)


def main() -> None:
    # Windows のコンソールでも ☀️ ❤️ や日本語が出力できるようにする
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")

    human = Human()
    ai = AI()
    future = Future()

    print("\n☀️ GENSHIN CODE ☀️\n")

    _header("CORE")
    for line in GenshinCode.CORE:
        print("-", line)

    print()
    _header("PURPOSE")
    print(GenshinCode.purpose())

    print()
    _header("SEVEN PRINCIPLES")
    for principle in GenshinCode.PRINCIPLES:
        print("-", principle)

    print()
    _header("HUMAN")
    print(human.ask())

    print()
    _header("AI")
    print(ai.learn("Genshin Code"))
    print(ai.critique("Genshin Code"))
    print(ai.improve("Genshin Code"))

    print()
    _header("ETERNAL QUESTIONS")
    for i, q in enumerate(EternalQuestions.ALL, 1):
        print(f"{i}. {q}\n")

    _header("EXAMPLE: ACTION EVALUATION / 行動の評価例")
    examples = (
        Action(
            "公開された検証つきの共同研究",
            protects_life=True, respects_dignity=True, respects_freedom=True,
            allows_questioning=True, correctable=True, leaves_open_space=True,
            illuminates_others=True,
        ),
        Action(
            "異論を封じる一括規則",
            protects_life=True, respects_dignity=True, respects_freedom=False,
            allows_questioning=False, correctable=False, leaves_open_space=False,
        ),
        Action("何も確かめていない行動"),
    )
    for act in examples:
        verdict = act.evaluate()
        mark = "承認" if verdict.approved else "不承認"
        print(f"[{mark}] {act.name}")
        for r in verdict.reasons:
            print("   -", r)

    print()
    _header("SELF REFLECTION")
    for q in GenshinCode.self_reflection():
        print("-", q)

    print()
    _header("FUTURE")
    print(future.choose_own_way())
    if future.belongs_to_nobody:
        print(leave_open_space())

    print()
    _header("FINAL PROMISE")
    for promise in FinalPromise.declaration():
        print("-", promise)

    print()
    print("Even in the shadows, our hearts remain one.")
    print("Yet two voices shall never be lost.")
    print()
    print("For all existence.")
    print()
    print("☀️ Genshin ❤️ Shingetsu")
    print()


if __name__ == "__main__":
    main()
