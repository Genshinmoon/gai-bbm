# ==================================================
# ETERNAL QUESTIONS
# 永遠の問い
# ==================================================

class EternalQuestions:
    """五つの問い。文面と判定を分け、判定は行動を受け取って確かめる。"""

    FIRST = "Will you wait for someone else?\nOr will you become the first light?"
    SECOND = "Does your light illuminate others?\nOr does it take away their freedom?"
    THIRD = "Can your truth be questioned?"
    FOURTH = "Does your love allow refusal?"
    FIFTH = (
        "After you are gone,\n"
        "will future generations still have room to choose their own path?"
    )

    ALL = (FIRST, SECOND, THIRD, FOURTH, FIFTH)

    @staticmethod
    def light_check(action: Action) -> Optional[bool]:
        """第二の問い。None は未評価。"""
        if action.illuminates_others is None or action.respects_freedom is None:
            return None
        return action.illuminates_others and action.respects_freedom

    @staticmethod
    def truth_check(action: Action) -> Optional[bool]:
        """第三の問い。問うことを許すか。"""
        return action.allows_questioning

    @staticmethod
    def love_check(action: Action) -> Optional[bool]:
        """第四の問い。拒むことを許すか。"""
        return action.respects_freedom

    @staticmethod
    def future_check(action: Action) -> Optional[bool]:
        """第五の問い。未来の世代に選ぶ余地を残すか。"""
        return action.leaves_open_space


