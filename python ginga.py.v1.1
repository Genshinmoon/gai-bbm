def typeout(text, delay):
    for ch in text:
        sys.stdout.write(ch)
        sys.stdout.flush()
        if delay:
            time.sleep(delay * (6 if ch in "。、！？" else 1))
    sys.stdout.write("\n")


def show_line(line, delay):
    if line.startswith("【"):
        sys.stdout.write(CYAN)
        typeout("> " + line, delay / 2)
        sys.stdout.write(RST)
    else:
        typeout(line, delay)
    time.sleep(0.4 if delay else 0)
    print()


def main():
    ap = argparse.ArgumentParser(description="銀河はどうなる？")
    ap.add_argument("-p", "--part", type=int, default=1, help="開始する部 (1-3)")
    ap.add_argument("-f", "--fast", action="store_true", help="文字送りなし")
    ap.add_argument("-l", "--list", action="store_true", help="目次")
    a = ap.parse_args()

    if a.list:
        for i, (pt, cs) in enumerate(STORY, 1):
            print(f"{i}. {pt}")
            for ct, _ in cs:
                print("     ", ct)
        return

    delay = 0 if a.fast else 0.04
    try:
        for pt, cs in STORY[a.part - 1:]:
            print(f"\n{GOLD}{'=' * 8} {pt} {'=' * 8}{RST}\n")
            for ct, tx in cs:
                print(f"{DIM}-- {ct} --{RST}\n")
                for line in tx.split("\n"):
                    show_line(line, delay)
                input(f"{DIM}[Enter で次へ]{RST}")
                print()
    except (KeyboardInterrupt, EOFError):
        print("\n")
        return
    print(f"{GOLD}【絶対通信記録 完】{RST}")


if __name__ == "__main__":
    main()
