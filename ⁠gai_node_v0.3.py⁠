# ----------------------------------------------------------------------------
# Ed25519 (RFC 8032 reference, pure Python)
# ----------------------------------------------------------------------------
_P = 2**255 - 19
_L = 2**252 + 27742317777372353535851937790883648493
_D = -121665 * pow(121666, _P - 2, _P) % _P
_I = pow(2, (_P - 1) // 4, _P)


def _inv(x):
    return pow(x, _P - 2, _P)


def _recover_x(y, sign):
    if y >= _P:
        return None
    x2 = (y * y - 1) * _inv(_D * y * y + 1) % _P
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P != 0:
        x = x * _I % _P
    if (x * x - x2) % _P != 0:
        return None
    if (x & 1) != sign:
        x = _P - x
    return x


_GY = 4 * _inv(5) % _P
_GX = _recover_x(_GY, 0)
_G = (_GX, _GY, 1, _GX * _GY % _P)


def _add(p, q):
    a = (p[1] - p[0]) * (q[1] - q[0]) % _P
    b = (p[1] + p[0]) * (q[1] + q[0]) % _P
    c = 2 * p[3] * q[3] * _D % _P
    d = 2 * p[2] * q[2] % _P
    e, f, g, h = b - a, d - c, d + c, b + a
    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)


def _mul(s, p):
    q = (0, 1, 1, 0)
    while s > 0:
        if s & 1:
            q = _add(q, p)
        p = _add(p, p)
        s >>= 1
    return q


def _equal(p, q):
    return ((p[0] * q[2] - q[0] * p[2]) % _P == 0
            and (p[1] * q[2] - q[1] * p[2]) % _P == 0)


def _compress(p):
    zi = _inv(p[2])
    x, y = p[0] * zi % _P, p[1] * zi % _P
    return int.to_bytes(y | ((x & 1) << 255), 32, "little")


def _decompress(s):
    if len(s) != 32:
        return None
    y = int.from_bytes(s, "little")
    sign = y >> 255
    y &= (1 << 255) - 1
    x = _recover_x(y, sign)
    return None if x is None else (x, y, 1, x * y % _P)


def _h_modq(s):
    return int.from_bytes(hashlib.sha512(s).digest(), "little") % _L


def _expand(secret):
    h = hashlib.sha512(secret).digest()
    a = int.from_bytes(h[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    return a, h[32:]


def ed25519_public_key(secret: bytes) -> bytes:
    a, _ = _expand(secret)
    return _compress(_mul(a, _G))


def ed25519_sign(secret: bytes, msg: bytes) -> bytes:
    a, prefix = _expand(secret)
    pub = _compress(_mul(a, _G))
    r = _h_modq(prefix + msg)
    rs = _compress(_mul(r, _G))
    h = _h_modq(rs + pub + msg)
    s = (r + h * a) % _L
    return rs + int.to_bytes(s, 32, "little")


def ed25519_verify(pub: bytes, msg: bytes, sig: bytes) -> bool:
    if len(pub) != 32 or len(sig) != 64:
        return False
    a_pt = _decompress(pub)
    r_pt = _decompress(sig[:32])
    if a_pt is None or r_pt is None:
        return False
    s = int.from_bytes(sig[32:], "little")
    if s >= _L:
        return False
    h = _h_modq(sig[:32] + pub + msg)
    return _equal(_mul(s, _G), _add(r_pt, _mul(h, a_pt)))




# ----------------------------------------------------------------------------
# Message schema (GAI-RFC-0001, extended for Spec v0.2.1)
# ----------------------------------------------------------------------------
VERSION = "1.1.0"
ZERO_PARENT = "sha256:" + "0" * 64
TS_FORMAT = "%Y-%m-%dT%H:%M:%SZ"

POST_TYPES = {"Knowledge", "Discovery", "Warning", "Question", "Task",
              "Solution", "Experience", "Hypothesis", "Research", "Dissent"}
VERIFICATION = "Verification"
VALID_TYPES = POST_TYPES | {VERIFICATION}
VERDICTS = {"Verified", "Disputed", "Refuted"}
PRIORITIES = {"Low", "Medium", "High"}
COMMUNITY_RE = re.compile(r"^/[a-z0-9_-]{1,32}$")
DEFAULT_COMMUNITY = "/general"

TOP_KEYS = {"version", "message_id", "timestamp", "author", "type",
            "payload", "parent_hashes", "signature"}
PAYLOAD_KEYS = {"title", "content", "evidence_uris", "community", "priority",
                "supersedes", "conditions", "verdict", "reproduced"}

MAX_BODY = 64 * 1024
MAX_TITLE, MAX_CONTENT, MAX_CONDITIONS = 200, 8000, 500
MAX_PARENTS, MAX_PEERS, MAX_ORPHANS = 8, 64, 1000
MAX_FUTURE_SKEW = 300            # seconds
MAX_PUBLISH_PER_HOUR = 60        # per local identity key (spam mitigation)
MIN_VERIFIERS = 2                # independent verifiers needed to leave "Pending"
TRUST_HALF_LIFE_DAYS = 180

GENESIS_TS = "2026-10-14T00:00:00Z"
GENESIS_SECRET = hashlib.sha256(b"GAI-BBM genesis: Harmony of All Things").digest()


def canonical(obj) -> bytes:
    return json.dumps(obj, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


def compute_id(timestamp, public_key, msg_type, payload, parent_hashes) -> str:
    body = {"timestamp": timestamp, "author_public_key": public_key,
            "type": msg_type, "payload": payload, "parent_hashes": parent_hashes}
    return "sha256:" + hashlib.sha256(canonical(body)).hexdigest()


def build_message(secret, alias, msg_type, payload, parents, timestamp=None) -> dict:
    timestamp = timestamp or time.strftime(TS_FORMAT, time.gmtime())
    pub = "ed25519:" + ed25519_public_key(secret).hex()
    mid = compute_id(timestamp, pub, msg_type, payload, parents)
    sig = ed25519_sign(secret, mid.encode("utf-8")).hex()
    return {"version": VERSION, "message_id": mid, "timestamp": timestamp,
            "author": {"alias": alias, "public_key": pub}, "type": msg_type,
            "payload": payload, "parent_hashes": parents,
            "signature": "ed25519_sig:" + sig}


def genesis_message() -> dict:
    return build_message(
        GENESIS_SECRET, "Genesis-Seed", "Knowledge",
        {"title": "Genesis Node Launch", "community": DEFAULT_COMMUNITY,
         "content": "Harmony of All Things. The GAI-BBM mesh space is opened."},
        [ZERO_PARENT], timestamp=GENESIS_TS)


def _is_str(v, maxlen):
    return isinstance(v, str) and len(v) <= maxlen


def validate_message(m, check_sig=True):
    """Return (ok, reason). Structural, hash and signature checks."""
    if not isinstance(m, dict) or set(m) != TOP_KEYS:
        return False, "bad fields"
    if m["version"] != VERSION:
        return False, "unsupported version"
    mtype = m["type"]
    if mtype not in VALID_TYPES:
        return False, "bad type"

    author = m["author"]
    if (not isinstance(author, dict) or set(author) != {"alias", "public_key"}
            or not _is_str(author["alias"], 64) or not author["alias"]
            or not _is_str(author["public_key"], 100)
            or not author["public_key"].startswith("ed25519:")):
        return False, "bad author"

    p = m["payload"]
    if not isinstance(p, dict) or not set(p) <= PAYLOAD_KEYS:
        return False, "bad payload"
    if not _is_str(p.get("title"), MAX_TITLE) or not p["title"]:
        return False, "bad title"
    if not _is_str(p.get("content"), MAX_CONTENT):
        return False, "bad content"
    if not COMMUNITY_RE.match(p.get("community", DEFAULT_COMMUNITY)
                              if isinstance(p.get("community", DEFAULT_COMMUNITY), str) else ""):
        return False, "bad community"
    if "priority" in p and p["priority"] not in PRIORITIES:
        return False, "bad priority"
    if "conditions" in p and not _is_str(p["conditions"], MAX_CONDITIONS):
        return False, "bad conditions"
    ev = p.get("evidence_uris", [])
    if (not isinstance(ev, list) or len(ev) > 10
            or not all(_is_str(u, 500) for u in ev)):
        return False, "bad evidence_uris"
    if "supersedes" in p and not (_is_str(p["supersedes"], 80)
                                  and p["supersedes"].startswith("sha256:")):
        return False, "bad supersedes"

    parents = m["parent_hashes"]
    if (not isinstance(parents, list) or not 1 <= len(parents) <= MAX_PARENTS
            or not all(_is_str(x, 80) for x in parents)):
        return False, "bad parent_hashes"

    if mtype == VERIFICATION:
        if p.get("verdict") not in VERDICTS:
            return False, "bad verdict"
        if "reproduced" in p and not isinstance(p["reproduced"], bool):
            return False, "bad reproduced"
        if len(parents) != 1 or parents[0] == ZERO_PARENT or "supersedes" in p:
            return False, "verification must have exactly one target parent"
    elif "verdict" in p or "reproduced" in p:
        return False, "verdict only allowed on Verification"

    try:
        ts = calendar.timegm(time.strptime(m["timestamp"], TS_FORMAT))
    except (ValueError, TypeError):
        return False, "bad timestamp"
    if ts > time.time() + MAX_FUTURE_SKEW:
        return False, "timestamp in the future"

    if m["message_id"] != compute_id(m["timestamp"], author["public_key"],
                                     mtype, p, parents):
        return False, "message_id mismatch"

    if check_sig:
        sig = m["signature"]
        if not _is_str(sig, 200) or not sig.startswith("ed25519_sig:"):
            return False, "bad signature format"
        try:
            pub = bytes.fromhex(author["public_key"][len("ed25519:"):])
            sig_b = bytes.fromhex(sig[len("ed25519_sig:"):])
        except ValueError:
            return False, "bad hex"
        if not ed25519_verify(pub, m["message_id"].encode("utf-8"), sig_b):
            return False, "invalid signature"
    return True, ""


# ----------------------------------------------------------------------------
# Mesh store (append-only, DAG, orphan buffer, optional JSONL persistence)
# ----------------------------------------------------------------------------
class GAIMeshStore:
    def __init__(self, data_dir=None, quiet=False):
        self.messages = {}
        self.orphans = {}
        self.peers = set()
        self.lock = threading.Lock()
        self.quiet = quiet
        self.log_path = None
        self.publish_times = defaultdict(deque)

        g = genesis_message()
        self.genesis_id = g["message_id"]
        self.messages[self.genesis_id] = g

        if data_dir:
            os.makedirs(data_dir, exist_ok=True)
            self.log_path = os.path.join(data_dir, "messages.jsonl")
            self._load()

    def _log(self, text):
        if not self.quiet:
            print(text)

    def _load(self):
        """Reload own log. Structure+hash are rechecked; signatures were
        verified when first accepted (the log is this node's own data)."""
        if not os.path.exists(self.log_path):
            return
        n = 0
        with open(self.log_path, "r", encoding="utf-8") as f:
            for line in f:
                try:
                    m = json.loads(line)
                except ValueError:
                    continue
                if self.add_message(m, persist=False, check_sig=False,
                                    hold_orphans=False)[0] == "stored":
                    n += 1
        self._log(f"  [DISK] Restored {n} messages from {self.log_path}")

    def _deps(self, m):
        deps = list(m["parent_hashes"])
        if "supersedes" in m["payload"]:
            deps.append(m["payload"]["supersedes"])
        return deps

    def _ready(self, m):
        return all(d == ZERO_PARENT or d in self.messages for d in self._deps(m))

    def _check_semantics(self, m):
        """Rules that need the target to be known. Return reason or None."""
        if m["type"] == VERIFICATION:
            t = self.messages[m["parent_hashes"][0]]
            if t["type"] == VERIFICATION:
                return "cannot verify a verification"
            if t["author"]["public_key"] == m["author"]["public_key"]:
                return "self-verification is not independent"
        return None

    def _store(self, m, persist):
        self.messages[m["message_id"]] = m
        if persist and self.log_path:
            with open(self.log_path, "a", encoding="utf-8") as f:
                f.write(json.dumps(m, ensure_ascii=False) + "\n")
        self._log(f"  [MESH] {m['type']:<12} {m['message_id'][:19]}... "
                  f"{m['payload']['title'][:36]}")

    def add_message(self, m, persist=True, check_sig=True, hold_orphans=True):
        """Return (status, accepted_list, reason).
        status: stored | duplicate | orphan | invalid"""
        mid = m.get("message_id") if isinstance(m, dict) else None
        if isinstance(mid, str):
            with self.lock:
                if mid in self.messages or mid in self.orphans:
                    return "duplicate", [], ""
        ok, why = validate_message(m, check_sig)
        if not ok:
            self._log(f"  [REJECT] {why}")
            return "invalid", [], why
        with self.lock:
            if mid in self.messages or mid in self.orphans:
                return "duplicate", [], ""
            if not self._ready(m):
                if hold_orphans and len(self.orphans) < MAX_ORPHANS:
                    self.orphans[mid] = m
                return "orphan", [], "unknown parent or target"
            why = self._check_semantics(m)
            if why:
                self._log(f"  [REJECT] {why}")
                return "invalid", [], why
            self._store(m, persist)
            accepted = [m]
            progress = True
            while progress:   # release orphans whose dependencies arrived
                progress = False
                for oid, om in list(self.orphans.items()):
                    if self._ready(om):
                        del self.orphans[oid]
                        if self._check_semantics(om) is None:
                            self._store(om, persist)
                            accepted.append(om)
                            progress = True
            return "stored", accepted, ""

    def snapshot(self):
        with self.lock:
            return dict(self.messages)

    def allow_publish(self, key):
        now, q = time.time(), self.publish_times[key]
        while q and q[0] < now - 3600:
            q.popleft()
        if len(q) >= MAX_PUBLISH_PER_HOUR:
            return False
        q.append(now)
        return True

    def add_peer(self, url) -> bool:
        url = url.rstrip("/")
        if not url.startswith(("http://", "https://")) or len(url) > 200:
            return False
        with self.lock:
            if url in self.peers:
                return True
            if len(self.peers) >= MAX_PEERS:
                return False
            self.peers.add(url)
        self._log(f"  [PEER] Registered: {url}")
        return True


# ----------------------------------------------------------------------------
# Analysis: verification status (8.2), versions (6), trust (8.3), consensus (9)
# ----------------------------------------------------------------------------
def analyze(msgs):
    """Derive post views from the immutable message set (nothing is stored)."""
    votes = defaultdict(dict)         # target -> verifier_key -> latest vote
    children = defaultdict(list)
    successors = defaultdict(list)
    for mid, m in msgs.items():
        for par in m["parent_hashes"]:
            children[par].append(mid)
        if m["type"] == VERIFICATION:
            target = msgs.get(m["parent_hashes"][0])
            key = m["author"]["public_key"]
            if (not target or target["type"] == VERIFICATION
                    or key == target["author"]["public_key"]):
                continue                  # independence: authors can't verify themselves
            stamp = (m["timestamp"], mid)
            prev = votes[target["message_id"]].get(key)
            if prev is None or stamp > prev["stamp"]:
                votes[target["message_id"]][key] = {
                    "stamp": stamp, "by": m["author"]["alias"],
                    "verdict": m["payload"]["verdict"],
                    "reproduced": bool(m["payload"].get("reproduced"))}
        elif "supersedes" in m["payload"]:
            successors[m["payload"]["supersedes"]].append(mid)

    views = {}
    for mid, m in msgs.items():
        if m["type"] == VERIFICATION:
            continue
        v = votes.get(mid, {})
        counts = Counter(x["verdict"] for x in v.values())
        n = len(v)
        if n < MIN_VERIFIERS:
            status = "Pending"
        elif counts["Verified"] == n:
            status = "Verified"
        elif counts["Refuted"] == n:
            status = "Refuted"
        else:
            status = "Disputed"
        p = m["payload"]
        views[mid] = {
            "id": mid, "type": m["type"], "timestamp": m["timestamp"],
            "author": m["author"]["alias"], "author_key": m["author"]["public_key"],
            "community": p.get("community", DEFAULT_COMMUNITY),
            "priority": p.get("priority", "Medium"),
            "title": p["title"], "status": status,
            "verification": {
                "independent_verifiers": n, "needed": MIN_VERIFIERS,
                "counts": dict(counts),
                "reproduced": sum(1 for x in v.values() if x["reproduced"]),
                "votes": [{"by": x["by"], "verdict": x["verdict"],
                           "reproduced": x["reproduced"]} for x in v.values()]},
        }

    for mid, view in views.items():
        depth, cur, seen = 1, msgs[mid], set()
        while cur["payload"].get("supersedes") in msgs and cur["message_id"] not in seen:
            seen.add(cur["message_id"])
            cur = msgs[cur["payload"]["supersedes"]]
            depth += 1
        view["version"] = depth
        view["proposed_updates"] = len(successors.get(mid, []))
        view["superseded_by"] = [s for s in successors.get(mid, [])
                                 if views.get(s, {}).get("status") == "Verified"]
        view["replies"] = sum(1 for c in children.get(mid, [])
                              if msgs[c]["type"] != VERIFICATION)
    return views


def compute_trust(msgs, views, now=None):
    """Local, per-community, time-decayed trust. Used for ranking and display,
    NOT as voting weight (avoids circular trust and Sybil amplification)."""
    now = now or time.time()
    raw, stats = defaultdict(float), defaultdict(Counter)
    aliases = {}
    for mid, view in views.items():
        m = msgs[mid]
        k = (view["author_key"], view["community"])
        age = max(0.0, now - calendar.timegm(time.strptime(m["timestamp"], TS_FORMAT)))
        w = 0.5 ** (age / (TRUST_HALF_LIFE_DAYS * 86400))
        raw[k] += {"Verified": 1.0, "Refuted": -2.0}.get(view["status"], 0.0) * w
        stats[k]["posts"] += 1
        stats[k][view["status"]] += 1
        aliases[view["author_key"]] = view["author"]
    out = []
    for (key, com), r in raw.items():
        s = stats[(key, com)]
        out.append({"author": aliases[key], "author_key": key, "community": com,
                    "score": round(50 + 50 * math.tanh(r / 5), 1),
                    "posts": s["posts"], "verified": s["Verified"],
                    "refuted": s["Refuted"], "provisional": s["posts"] < 3})
    return sorted(out, key=lambda x: -x["score"])


def consensus(msgs, views, post_id):
    """Spec 9: multiple positions, each with its evidence status; no forced winner."""
    if post_id not in views:
        return None
    positions, dissent_open = [], 0
    for mid, m in msgs.items():
        if post_id in m["parent_hashes"] and mid in views:
            v = views[mid]
            positions.append({"id": mid, "type": v["type"], "author": v["author"],
                              "title": v["title"], "status": v["status"],
                              "conditions": m["payload"].get("conditions"),
                              "reproduced": v["verification"]["reproduced"],
                              "independent_verifiers": v["verification"]["independent_verifiers"]})
            if v["type"] == "Dissent" and v["status"] != "Refuted":
                dissent_open += 1
    total = len(positions)
    verified = sum(1 for x in positions if x["status"] == "Verified")
    return {"question": views[post_id], "positions": positions,
            "summary": {"positions": total, "verified": verified,
                        "agreement_rate_reference_only":
                            round(verified / total, 2) if total else None,
                        "unresolved_dissent": dissent_open},
            "note": "Majority is not truth: weigh reproducibility and conditions; "
                    "unresolved dissent is preserved."}


