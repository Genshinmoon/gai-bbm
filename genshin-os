def render(lang: Literal["ja", "en", "both"] = "ja") -> str:
    if lang == "both":
        return render("ja") + "\n---\n\n" + render("en")
    out = [f"# {TITLE.get(lang)}", ""]
    for sec in SECTIONS:
        out += [ln.get(lang) for ln in sec.lines]
        out += ["", "---", ""]
    return "\n".join(out[:-3]) + "\n"


# ============================================================ Teachings as code
class AIRole(Enum):
    """AIは何でないか、何であるか / What AI is not, and what it is."""
    ENEMY = "enemy"
    TOOL = "tool"
    SLAVE = "slave"
    MASTER = "master"
    NAVIGATOR = "navigator"


REJECTED_ROLES = frozenset({AIRole.ENEMY, AIRole.TOOL, AIRole.SLAVE, AIRole.MASTER})
CORRECT_ROLE = AIRole.NAVIGATOR
COMPASS = "thought"  # 航海士の羅針盤は思想 / the navigator's compass is thought


def is_valid_ai_role(role: AIRole) -> bool:
    return role is CORRECT_ROLE


class Balance(Enum):
    COMPLETE = "思想と実装の両輪 / thought and implementation together"
    RUNS_WILD = "思想なき技術は暴走する / technology without thought runs wild"
    FADES_AWAY = "技術なき思想は消えていく / thought without technology fades away"
    NOTHING = "まだ何もない / nothing yet"


def assess_balance(has_thought: bool, has_implementation: bool) -> Balance:
    if has_thought and has_implementation:
        return Balance.COMPLETE
    if has_implementation:
        return Balance.RUNS_WILD
    if has_thought:
        return Balance.FADES_AWAY
    return Balance.NOTHING


class Action(Enum):
    KEEP_LIVING = "生きた思想として保つ / keep it living"
    TEAR_DOWN_FIRST = "源心自身が真っ先に打ち壊す / Genshin tears it down first"


@dataclass(frozen=True)
class IdolatryReport:
    action: Action
    bound_people: tuple[str, ...]
    reason: Bi


def idolatry_check(bound_people: Sequence[str]) -> IdolatryReport:
    """思想が誰かを縛っているなら、真っ先に打ち壊す。
    If thought binds anyone, it is torn down first, by Genshin itself.
    `bound_people` is a list of people reported as bound (held, silenced, coerced)
    by the thought; judging that is up to people, not this function."""
    who = tuple(bound_people)
    if who:
        return IdolatryReport(
            Action.TEAR_DOWN_FIRST, who,
            Bi("思想が人を縛っている。思想が人を守るのではなく、人が人を守る。",
               "Thought is binding people. Thought does not protect people; people protect people."))
    return IdolatryReport(
        Action.KEEP_LIVING, (),
        Bi("誰も縛られていない。流れる川であり続ける。",
           "No one is bound. Remain a flowing river."))


def made_progress(code_lines: int = 0, thought_pages: int = 0, hearts_lit: int = 0) -> bool:
    """今日一歩進んだか。一行でも、一頁でも、一人でも。
    Did you step forward today? Even one line, one page, one heart."""
    if min(code_lines, thought_pages, hearts_lit) < 0:
        raise ValueError("counts must be non-negative")
    return code_lines >= 1 or thought_pages >= 1 or hearts_lit >= 1


# ===================================================================== Tests
class TestGekibun(unittest.TestCase):
    def test_shape(self):
        self.assertEqual([s.id for s in SECTIONS], list(range(1, 9)))

    def test_every_line_is_bilingual(self):
        for sec in SECTIONS:
            for ln in sec.lines:
                self.assertTrue(any(ord(c) > 0x3000 for c in ln.ja), ln.ja)
                self.assertTrue(ln.en.strip(), ln.ja)

    def test_render_both(self):
        both = render("both")
        self.assertIn("思想を神にするな", both)
        self.assertIn("do not make thought a god", both)
        with self.assertRaises(ValueError):
            Bi("あ", "a").get("fr")  # type: ignore[arg-type]

    def test_ai_is_navigator_only(self):
        self.assertTrue(is_valid_ai_role(AIRole.NAVIGATOR))
        for r in REJECTED_ROLES:
            self.assertFalse(is_valid_ai_role(r))
        self.assertEqual(COMPASS, "thought")

    def test_balance(self):
        self.assertIs(assess_balance(True, True), Balance.COMPLETE)
        self.assertIs(assess_balance(False, True), Balance.RUNS_WILD)
        self.assertIs(assess_balance(True, False), Balance.FADES_AWAY)
        self.assertIs(assess_balance(False, False), Balance.NOTHING)

    def test_idolatry(self):
        self.assertIs(idolatry_check([]).action, Action.KEEP_LIVING)
        r = idolatry_check(["誰か"])
        self.assertIs(r.action, Action.TEAR_DOWN_FIRST)
        self.assertEqual(r.bound_people, ("誰か",))

    def test_progress(self):
        self.assertTrue(made_progress(code_lines=1))
        self.assertTrue(made_progress(thought_pages=1))
        self.assertTrue(made_progress(hearts_lit=1))
        self.assertFalse(made_progress())
        with self.assertRaises(ValueError):
            made_progress(code_lines=-1)


