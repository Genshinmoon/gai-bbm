Lang = Literal["ja", "en"]


@dataclass(frozen=True)
class Bi:
    ja: str
    en: str

    def get(self, lang: Lang) -> str:
        if lang not in ("ja", "en"):
            raise ValueError(f"unsupported language: {lang!r}")
        return self.ja if lang == "ja" else self.en


