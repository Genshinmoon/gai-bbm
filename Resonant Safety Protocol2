def record_to_dict(rec: ReconciliationRecord) -> dict[str, Any]:
    return {
        "record_id": rec.record_id,
        "timestamp": rec.timestamp,
        "command_text": rec.command_text,
        "intents": list(rec.intents),
        "suspected_intents": list(rec.suspected_intents),
        "dissents": list(rec.dissents),
        "shared_signals": list(rec.shared_signals),
        "resonant_signals": list(rec.resonant_signals),
        "signal_intensities": dict(rec.signal_intensities),
        "silent_margins": list(rec.silent_margins),
        "unnamed_wounds": list(rec.unnamed_wounds),
        "interpretation_sources": list(getattr(rec, "interpretation_sources", [])),
        "urgency": rec.urgency,
        "dynamic_phase": rec.dynamic_phase,
        "plan_summary": list(rec.plan_summary),
        "lesson_learned": rec.lesson_learned,
        "verifiers": [{"name": s.name, "entity_type": s.entity_type.name} for s in rec.verifiers],
        "lesson_history": list(rec.lesson_history),
        "severity_weight": getattr(rec, "severity_weight", 1.0), # 重みの保存
    }


def record_from_dict(d: dict[str, Any]) -> ReconciliationRecord:
    try:
        rec = ReconciliationRecord(
            record_id=str(d["record_id"]),
            timestamp=float(d["timestamp"]),
            command_text=d["command_text"],
            intents=tuple(d["intents"]),
            suspected_intents=tuple(d["suspected_intents"]),
            dissents=tuple(d["dissents"]),
            shared_signals=tuple(d["shared_signals"]),
            resonant_signals=tuple(d["resonant_signals"]),
            signal_intensities={str(k): float(v) for k, v in d["signal_intensities"].items()},
            silent_margins=tuple(d["silent_margins"]),
            unnamed_wounds=tuple(d.get("unnamed_wounds", [])),
            interpretation_sources=tuple(d.get("interpretation_sources", [])),
            urgency=str(d["urgency"]),
            dynamic_phase=str(d.get("dynamic_phase", "通常共鳴位相")),
            plan_summary=tuple(d["plan_summary"]),
            lesson_learned=str(d.get("lesson_learned", "")),
            verifiers=tuple(
                Signature(v["name"], EntityType[v["entity_type"]]) for v in d.get("verifiers", [])
            ),
            lesson_history=tuple(d.get("lesson_history", [])),
        )
        # Python の dataclass は frozen なので、setattr して重みを保持するか、フィールドに追加する必要がある
        # ここでは動的に追加（型定義の変更を最小限に抑えるため）
        object.__setattr__(rec, "severity_weight", float(d.get("severity_weight", 1.0)))
        return rec
    except (KeyError, TypeError, AttributeError) as exc:
        raise ValueError(f"カルテの形式が正しくありません: {exc!r}") from exc


def save_ledger(ledger: ReconciliationLedger, path: str) -> None:
    payload = {
        "format": LEDGER_FORMAT,
        "protocol_version": PROTOCOL_VERSION,
        "records": [record_to_dict(r) for r in ledger.records()],
    }
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".ledger-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(payload, f, ensure_ascii=False, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def load_ledger(
    path: str, max_records: int = 1000, store_command_text: bool = True
) -> ReconciliationLedger:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict) or data.get("format") != LEDGER_FORMAT:
        found = data.get("format") if isinstance(data, dict) else None
        raise ValueError(f"未対応の台帳形式です (format={found})")
    ledger = ReconciliationLedger(max_records=max_records, store_command_text=store_command_text)
    ledger.load_records([record_from_dict(d) for d in data.get("records", [])])
    return ledger
